            {"pointer": "/required", "operator": "exact_set", "expected": ["schema_version", "event_id", "run_id", "task_id", "sequence", "timestamp", "type", "source", "payload", "artifact_refs"]},
            {"pointer": "/additionalProperties", "operator": "equals", "expected": false},
