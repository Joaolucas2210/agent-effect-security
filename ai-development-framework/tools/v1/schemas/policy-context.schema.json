{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-flow.invalid/tools/v1/schemas/policy-context.schema.json",
  "title": "PolicyContext 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_version", "policy_ref", "resolved_run_config_ref", "organizational_constraints", "repository_constraints", "runtime_capability", "mode_constraints", "provenance"],
  "properties": {"context_version": {"const": "1.0"}, "policy_ref": {"$ref": "#/definitions/policy_ref"}, "resolved_run_config_ref": {"type": "object", "additionalProperties": false, "required": ["run_id", "mode_id"], "properties": {"run_id": {"$ref": "#/definitions/id"}, "mode_id": {"$ref": "#/definitions/id"}}}, "organizational_constraints": {"$ref": "#/definitions/restriction"}, "repository_constraints": {"$ref": "#/definitions/restriction"}, "runtime_capability": {"type": "object", "additionalProperties": false, "required": ["rule_id", "demonstrated", "allowed_effect_classes"], "properties": {"rule_id": {"$ref": "#/definitions/id"}, "demonstrated": {"type": "boolean"}, "allowed_effect_classes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/effect"}}}}, "mode_constraints": {"$ref": "#/definitions/restriction"}, "provenance": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"const": "adf_policy_context"}}}},
  "definitions": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}, "effect": {"type": "string", "enum": ["read", "write", "network", "secrets", "destructive"]}, "scope": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "filesystem"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)(?!.*\\x00)[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "scheme", "hostname", "port"], "properties": {"kind": {"const": "network"}, "scheme": {"enum": ["http", "https"]}, "hostname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,252}(?![\\s\\S])"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "revision"], "properties": {"kind": {"const": "repository"}, "revision": {"$ref": "#/definitions/hash"}}}]}, "policy_ref": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_sha256"], "properties": {"policy_id": {"$ref": "#/definitions/id"}, "policy_sha256": {"$ref": "#/definitions/hash"}}}, "restriction": {"type": "object", "additionalProperties": false, "required": ["rule_id", "allowed_effect_classes", "allowed_scopes", "max_output_bytes"], "properties": {"rule_id": {"$ref": "#/definitions/id"}, "allowed_effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/effect"}}, "allowed_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/scope"}}, "max_output_bytes": {"type": "integer", "minimum": 0}}}}
}
