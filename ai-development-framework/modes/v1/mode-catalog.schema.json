{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-flow.invalid/modes/v1/mode-catalog.schema.json",
  "title": "ModeCatalog 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "modes"],
  "properties": {
    "catalog_version": {"const": "1.0"},
    "modes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/mode"},
      "allOf": [
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "prototyper"}}}},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "builder"}}}},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "grower"}}}},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "sweeper"}}}},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "maintainer"}}}}
      ]
    }
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"},
    "versioned": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/definitions/id"}, "version": {"type": "string", "minLength": 1}}},
    "restriction": {"type": "object", "additionalProperties": false, "required": ["id", "version", "description"], "properties": {"id": {"$ref": "#/definitions/id"}, "version": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "mode": {"type": "object", "additionalProperties": false, "required": ["id", "version", "objective", "context_policy", "verification_policy", "budget_posture", "restrictions", "policy"], "properties": {"id": {"enum": ["prototyper", "builder", "grower", "sweeper", "maintainer"]}, "version": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "context_policy": {"$ref": "#/definitions/versioned"}, "verification_policy": {"$ref": "#/definitions/versioned"}, "budget_posture": {"$ref": "#/definitions/versioned"}, "restrictions": {"type": "array", "items": {"$ref": "#/definitions/restriction"}}, "policy": {"$ref": "#/definitions/versioned"}}}
  }
}
