{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-flow.invalid/integration/v2/attempt-timing.schema.json",
  "title": "AdapterAttemptTiming 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "start_event_sha256",
    "return_state",
    "durations_ms",
    "provenance",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "start_event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "return_state": {
      "enum": [
        "returned",
        "raised"
      ]
    },
    "durations_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare",
        "decision",
        "read",
        "persistence",
        "cleanup",
        "total"
      ],
      "properties": {
        "prepare": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "decision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "read": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "persistence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cleanup": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "collector_version",
        "adapter_version",
        "clock",
        "unit",
        "total_boundary"
      ],
      "properties": {
        "kind": {
          "const": "host_adapter_timing"
        },
        "collector_version": {
          "const": "1.0"
        },
        "adapter_version": {
          "const": "1.0"
        },
        "clock": {
          "const": "monotonic_ns"
        },
        "unit": {
          "const": "ms"
        },
        "total_boundary": {
          "const": "adapter_read_return_or_raise"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "record_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "json-c14n-v1"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
