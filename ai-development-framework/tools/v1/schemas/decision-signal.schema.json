{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-flow.invalid/tools/v1/schemas/decision-signal.schema.json",
  "title": "DecisionSignal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "question_id", "kind", "abstain", "answer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"},
    "question_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"},
    "kind": {"enum": ["yes_no", "choice", "score"]},
    "abstain": {"type": "boolean"},
    "answer": {"type": ["null", "boolean", "string", "number"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "oneOf": [
    {"properties": {"abstain": {"const": true}, "answer": {"type": "null"}}},
    {"properties": {"abstain": {"const": false}, "kind": {"const": "yes_no"}, "answer": {"type": "boolean"}}},
    {"properties": {"abstain": {"const": false}, "kind": {"const": "choice"}, "answer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"}}},
    {"properties": {"abstain": {"const": false}, "kind": {"const": "score"}, "answer": {"type": "number", "minimum": 0, "maximum": 1}}}
  ]
}
