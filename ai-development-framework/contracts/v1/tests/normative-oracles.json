        {
          "source_document": "docs/specs/agent-development-harness.md",
          "source_section": "§10 Primeiro vertical slice: um gate real com eventos v1",
          "requirement": "The four initial types use closed payloads: run.started, gate.started, gate.finished=GateResult and run.completed; the sequence starts at 1, duration is null|non-negative number, and tokens/cost in this slice are null.",
          "checks": [
            {"pointer": "/oneOf", "operator": "equals", "expected": [{"properties": {"type": {"const": "run.started"}, "payload": {"$ref": "#/definitions/run.started"}}}, {"properties": {"type": {"const": "gate.started"}, "payload": {"$ref": "#/definitions/gate.started"}}}, {"properties": {"type": {"const": "gate.finished"}, "payload": {"$ref": "gate-result.schema.json"}}}, {"properties": {"type": {"const": "run.completed"}, "payload": {"$ref": "#/definitions/run.completed"}}}]},
            {"pointer": "/definitions", "operator": "equals", "expected": {"run.started": {"type": "object", "required": ["case", "repo_revision", "instrumentation_version"], "additionalProperties": false, "properties": {"case": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"}, "repo_revision": {"type": "string", "minLength": 1}, "instrumentation_version": {"type": "string", "minLength": 1}}}, "gate.started": {"type": "object", "required": ["gate_id", "category", "required"], "additionalProperties": false, "properties": {"gate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"}, "category": {"enum": ["build", "test", "lint", "types", "architecture", "security", "functional", "llm_review", "human"]}, "required": {"type": "boolean"}}}, "run.completed": {"type": "object", "required": ["outcome", "duration_seconds", "tokens_in", "tokens_out", "cost_usd"], "additionalProperties": false, "properties": {"outcome": {"enum": ["success", "failure", "skipped", "error"]}, "duration_seconds": {"type": ["number", "null"], "minimum": 0}, "tokens_in": {"type": "null"}, "tokens_out": {"type": "null"}, "cost_usd": {"type": "null"}}}}}
          ]
        },
        {
          "source_document": "docs/specs/agent-development-harness.md",
          "source_section": "§6 Contratos propostos",
          "requirement": "extensions is an optional informative object; it does not stand in for a required field, does not change the normative interpretation, and grants no authorization.",
