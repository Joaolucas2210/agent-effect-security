{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:adf:task-evaluation:1.0",
  "title": "External task evaluation (separate from session report v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "task_id", "session_id", "report_sha256", "acceptance_sha256", "initial_revision_sha", "evaluated_revision_sha", "evaluator_id", "evaluator_version", "created_at", "task_outcome", "result_sha256", "verification"],
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "trial_id": {"$ref": "#/definitions/id"},
    "task_id": {"$ref": "#/definitions/id"},
    "session_id": {"$ref": "#/definitions/id"},
    "report_sha256": {"$ref": "#/definitions/sha256"},
    "acceptance_sha256": {"$ref": "#/definitions/sha256"},
    "initial_revision_sha": {"$ref": "#/definitions/revision"},
    "evaluated_revision_sha": {"$ref": "#/definitions/revision"},
    "evaluator_id": {"$ref": "#/definitions/id"},
    "evaluator_version": {"$ref": "#/definitions/id"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "task_outcome": {"enum": ["success", "failure", "skipped"]},
    "result_sha256": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalization", "evaluation_sha256"],
      "properties": {
        "canonicalization": {"const": "json-c14n-v1"},
        "evaluation_sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  },
  "if": {"properties": {"task_outcome": {"const": "skipped"}}},
  "then": {"properties": {"result_sha256": {"type": "null"}}},
  "else": {"properties": {"result_sha256": {"$ref": "#/definitions/sha256"}}}
}
