{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-flow.invalid/runtime/v1/schemas/sensitive-path-policy-v1.schema.json",
  "title": "SensitivePathPolicyV1 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "default_outcome", "deny_components", "deny_component_prefixes", "deny_component_suffixes", "provenance"],
  "properties": {
    "policy_version": {"const": "1.0"}, "default_outcome": {"const": "allow"},
    "deny_components": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "deny_component_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "deny_component_suffixes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "adr"], "properties": {"source": {"const": "adf_local_policy"}, "adr": {"const": "0008"}}}
  }
}
