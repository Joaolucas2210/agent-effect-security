  "definitions": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9.][A-Za-z0-9._/-]*(?![\\s\\S])"}, "host": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*(?![\\s\\S])"}, "operation": {"type": "object", "additionalProperties": false, "required": ["id", "input_schema", "read", "write", "network", "secret_access", "destructive", "allowed_paths", "allowed_hosts", "timeout_seconds", "max_output_bytes", "approval", "provenance_required"], "properties": {"id": {"$ref": "#/definitions/id"}, "input_schema": {"type": "object"}, "read": {"type": "boolean"}, "write": {"type": "boolean"}, "network": {"type": "boolean"}, "secret_access": {"type": "boolean"}, "destructive": {"type": "boolean"}, "allowed_paths": {"type": "array", "items": {"$ref": "#/definitions/path"}}, "allowed_hosts": {"type": "array", "items": {"$ref": "#/definitions/host"}}, "timeout_seconds": {"type": "integer", "minimum": 0}, "max_output_bytes": {"type": "integer", "minimum": 0}, "approval": {"enum": ["never", "conditional", "always"]}, "approval_rule_ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+(?![\\s\\S])"}, "provenance_required": {"type": "boolean"}}, "if": {"properties": {"approval": {"const": "conditional"}}}, "then": {"required": ["approval_rule_ref"]}, "else": {"not": {"required": ["approval_rule_ref"]}}}}
