{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-flow.invalid/tools/v1/schemas/policy-bundle.schema.json",
  "title": "PolicyBundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "policy_id", "policy_sha256", "default_outcome", "rules", "provenance"],
  "properties": {"policy_version": {"const": "1.0"}, "policy_id": {"$ref": "#/definitions/id"}, "policy_sha256": {"$ref": "#/definitions/hash"}, "default_outcome": {"const": "deny"}, "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/rule"}}, "principal_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/principal_rule"}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"const": "adf_local_policy"}}}},
  "definitions": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}, "effect": {"type": "string", "enum": ["read", "write", "network", "secrets", "destructive"]}, "scope": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "filesystem"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)(?!.*\\x00)[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "scheme", "hostname", "port"], "properties": {"kind": {"const": "network"}, "scheme": {"enum": ["http", "https"]}, "hostname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,252}(?![\\s\\S])"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "revision"], "properties": {"kind": {"const": "repository"}, "revision": {"$ref": "#/definitions/hash"}}}]}, "principal_rule": {"type": "object", "additionalProperties": false, "required": ["sub", "allowed_scopes"], "properties": {"sub": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,127}(?![\\s\\S])"}, "allowed_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/scope"}}}}, "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "tool_id", "profile_sha256", "operation_id", "allowed_effect_classes", "allowed_scopes", "max_output_bytes"], "properties": {"rule_id": {"$ref": "#/definitions/id"}, "tool_id": {"$ref": "#/definitions/id"}, "profile_sha256": {"$ref": "#/definitions/hash"}, "operation_id": {"$ref": "#/definitions/id"}, "allowed_effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/effect"}}, "allowed_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/scope"}}, "max_output_bytes": {"type": "integer", "minimum": 0}}}}
}
